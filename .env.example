# Used by `docker compose`. Copy to `.env` (never commit `.env`).
# Every value is optional: with no keys the app runs in demo mode and returns
# placeholder answers, so the whole pipeline can still be demonstrated.

# Free providers: aistudio.google.com and console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database password (change it on any shared machine)
POSTGRES_PASSWORD=router

# Only change these if the app is opened from a different PC than the one running Docker,
# e.g. http://192.168.1.20:8000 and http://192.168.1.20:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
