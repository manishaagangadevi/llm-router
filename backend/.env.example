# Free providers (get keys at aistudio.google.com and console.groq.com)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which model serves each routing tier (change if a model gets retired)
FAST_MODEL=llama-3.1-8b-instant
BALANCED_MODEL=gemini-2.5-flash
PREMIUM_MODEL=llama-3.3-70b-versatile

DATABASE_URL=sqlite+aiosqlite:///./router.db
CORS_ORIGINS=http://localhost:3000
